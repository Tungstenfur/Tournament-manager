<Window x:Class="TournamentManager.Windows.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TournamentManager.Windows"
        mc:Ignorable="d"
        Title="Login" Height="450" Width="300">
    <Grid>
        <StackPanel>
            <Label FontSize="30">Zaloguj się</Label>
            <Label>Login</Label>
            <TextBox Name="usernameBox"></TextBox>
            <Label>Hasło</Label>
            <PasswordBox Name="passwordBox"></PasswordBox>
            <Button Name="loginButton" Content="Zaloguj" Click="loginButton_Click"></Button>
        </StackPanel>
    </Grid>
</Window>
