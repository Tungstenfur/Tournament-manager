<Window x:Class="TournamentManager.Windows.AddUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TournamentManager.Windows"
        mc:Ignorable="d"
        Title="AddUser" Height="250" Width="300">
    <Grid>
        <StackPanel>
            <Label Content="Nazwa użytkownika:"/>
            <TextBox Name="usernameTextBox"/>
            <Label Content="Hasło:"/>
            <PasswordBox Name="passwordTextBox"/>
            <Label Content="Rola:"/>
            <ComboBox Name="roleComboBox" ItemsSource="{Binding Roles, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:AddUser}}}"/>
            <Button Content="Dodaj" Click="AddUserButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
