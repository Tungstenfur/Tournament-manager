<Window x:Class="TournamentManager.Windows.AlterUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TournamentManager.Windows"
        mc:Ignorable="d"
        Title="AlterUser" Height="450" Width="300">
    <Grid>
        <StackPanel>
            <Label Content="Nazwa użytkownika:"/>
            <TextBox Name="UsernameTextBox"/>
            <CheckBox Name="ChangePasswordCheckBox" Content="Zmień hasło"/>
            <Label Content="Hasło:"/>
            <PasswordBox Name="PasswordTextBox" IsEnabled="{Binding IsChecked, ElementName=ChangePasswordCheckBox}"/>
            <Label Content="Rola:"/>
            <ComboBox Name="RoleComboBox" ItemsSource="{Binding Roles, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local:AlterUser}}}"/>
            <Button Content="Zapisz" Click="Button_Click"/>
        </StackPanel>
    </Grid>
</Window>
